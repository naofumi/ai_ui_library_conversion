<main class="mx-auto max-w-7xl px-6 py-10">
  <header class="mb-8">
    <%= link_to "← Back", root_path, class: "text-sm text-zinc-600 hover:text-zinc-900" %>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight"><%= @component.page_title %></h1>
    <p class="mt-2 text-sm text-zinc-600"><%= @component.page_description %></p>
  </header>

  <section class="grid gap-6 lg:grid-cols-2">
    <article class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
      <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-zinc-500">Source (React + shadcn)</h2>
      <div data-react="shadcn-accordion-demo" class="rounded-lg border border-dashed border-zinc-300 p-6"></div>
    </article>

    <article class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
      <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-zinc-500">Converted (Rails + Tailwind + Stimulus)</h2>
      <!-- CODE:converted:start -->
      <div class="rounded-lg border border-dashed border-zinc-300 p-6">
        <div class="w-full max-w-md" data-controller="accordion-preview" data-accordion-preview-type-value="single" data-accordion-preview-open-value="item-1">
          <div class="sc-accordion__item" data-accordion-preview-target="item" data-accordion-preview-value-param="item-1" data-state="open">
            <h3>
              <button type="button" class="sc-accordion__trigger" data-accordion-preview-target="trigger" data-accordion-preview-value-param="item-1" data-action="accordion-preview#toggle" aria-expanded="true">
                <span>Is it accessible?</span>
                <svg class="sc-accordion__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </button>
            </h3>
            <div class="sc-accordion__content" data-accordion-preview-target="content" data-accordion-preview-value-param="item-1">
              <div class="sc-accordion__content-inner">Yes. It adheres to the WAI-ARIA design pattern.</div>
            </div>
          </div>

          <div class="sc-accordion__item" data-accordion-preview-target="item" data-accordion-preview-value-param="item-2" data-state="closed">
            <h3>
              <button type="button" class="sc-accordion__trigger" data-accordion-preview-target="trigger" data-accordion-preview-value-param="item-2" data-action="accordion-preview#toggle" aria-expanded="false">
                <span>Is it styled?</span>
                <svg class="sc-accordion__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </button>
            </h3>
            <div class="sc-accordion__content" data-accordion-preview-target="content" data-accordion-preview-value-param="item-2" hidden>
              <div class="sc-accordion__content-inner">Yes. It comes with default styles that match the other components.</div>
            </div>
          </div>

          <div class="sc-accordion__item" data-accordion-preview-target="item" data-accordion-preview-value-param="item-3" data-state="closed">
            <h3>
              <button type="button" class="sc-accordion__trigger" data-accordion-preview-target="trigger" data-accordion-preview-value-param="item-3" data-action="accordion-preview#toggle" aria-expanded="false">
                <span>Is it animated?</span>
                <svg class="sc-accordion__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </button>
            </h3>
            <div class="sc-accordion__content" data-accordion-preview-target="content" data-accordion-preview-value-param="item-3" hidden>
              <div class="sc-accordion__content-inner">Yes. Height animation is included by default for open and close.</div>
            </div>
          </div>
        </div>
      </div>
      <!-- CODE:converted:end -->
    </article>
  </section>

  <section class="mt-6 grid gap-6 lg:grid-cols-2">
    <%= render "shared/code_panel", title: "Source Code (React)", code: @source_code %>
    <%= render "shared/code_panel", title: "Converted Code (ERB)", code: @converted_code %>
  </section>
</main>
