<main class="mx-auto max-w-7xl px-6 py-10">
  <header class="mb-8">
    <%= link_to "← Back", root_path, class: "text-sm text-zinc-600 hover:text-zinc-900" %>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight"><%= @component.page_title %></h1>
    <p class="mt-2 text-sm text-zinc-600"><%= @component.page_description %></p>
  </header>

  <section class="grid gap-6 lg:grid-cols-2">
    <article class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
      <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-zinc-500">Source (React + shadcn)</h2>
      <div data-react="shadcn-tabs-demo" class="rounded-lg border border-dashed border-zinc-300 p-6"></div>
    </article>

    <article class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
      <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-zinc-500">Converted (Rails + Tailwind + Stimulus)</h2>
      <!-- CODE:converted:start -->
      <div class="rounded-lg border border-dashed border-zinc-300 p-6">
        <div class="sc-tabs max-w-md" data-controller="tabs-preview" data-tabs-preview-active-value="account">
          <div role="tablist" class="sc-tabs__list">
            <button type="button" role="tab" class="sc-tabs__trigger" data-tabs-preview-target="trigger" data-tabs-preview-value-param="account" data-action="tabs-preview#select">Account</button>
            <button type="button" role="tab" class="sc-tabs__trigger" data-tabs-preview-target="trigger" data-tabs-preview-value-param="password" data-action="tabs-preview#select">Password</button>
            <button type="button" role="tab" class="sc-tabs__trigger" disabled data-tabs-preview-target="trigger" data-tabs-preview-value-param="disabled">Disabled</button>
          </div>
          <div role="tabpanel" class="sc-tabs__content" data-tabs-preview-target="content" data-tabs-preview-value-param="account">
            <div class="sc-tabs__panel">Make changes to your account here. Click save when you are done.</div>
          </div>
          <div role="tabpanel" class="sc-tabs__content" data-tabs-preview-target="content" data-tabs-preview-value-param="password" hidden>
            <div class="sc-tabs__panel">Change your password here. After saving, you will be logged out.</div>
          </div>
        </div>
      </div>
      <!-- CODE:converted:end -->
    </article>
  </section>

  <section class="mt-6 grid gap-6 lg:grid-cols-2">
    <%= render "shared/code_panel", title: "Source Code (React)", code: @source_code %>
    <%= render "shared/code_panel", title: "Converted Code (ERB)", code: @converted_code %>
  </section>
</main>
