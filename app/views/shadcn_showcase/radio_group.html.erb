<main class="mx-auto max-w-7xl px-6 py-10">
  <header class="mb-8">
    <%= link_to "← Back", root_path, class: "text-sm text-zinc-600 hover:text-zinc-900" %>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight"><%= @component.page_title %></h1>
    <p class="mt-2 text-sm text-zinc-600"><%= @component.page_description %></p>
  </header>

  <section class="grid gap-6 lg:grid-cols-2">
    <article class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
      <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-zinc-500">Source (React + shadcn)</h2>
      <div data-react="shadcn-radio-group-demo" class="rounded-lg border border-dashed border-zinc-300 p-6"></div>
    </article>

    <article class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
      <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-zinc-500">Converted (Rails + Tailwind)</h2>
      <!-- CODE:converted:start -->
      <div class="rounded-lg border border-dashed border-zinc-300 p-6">
        <div role="radiogroup" class="sc-radio-group">
          <div class="flex items-center gap-3">
            <input id="converted-r1" type="radio" name="converted-density" value="default" class="sc-radio">
            <label for="converted-r1" class="sc-label">Default</label>
          </div>
          <div class="flex items-center gap-3">
            <input id="converted-r2" type="radio" name="converted-density" value="comfortable" checked class="sc-radio">
            <label for="converted-r2" class="sc-label">Comfortable</label>
          </div>
          <div class="flex items-center gap-3">
            <input id="converted-r3" type="radio" name="converted-density" value="compact" class="sc-radio">
            <label for="converted-r3" class="sc-label">Compact</label>
          </div>
          <div class="flex items-center gap-3">
            <input id="converted-r4" type="radio" name="converted-density" value="disabled" disabled class="sc-radio">
            <label for="converted-r4" class="sc-label sc-label--disabled">Disabled</label>
          </div>
        </div>
      </div>
      <!-- CODE:converted:end -->
    </article>
  </section>

  <section class="mt-6 grid gap-6 lg:grid-cols-2">
    <%= render "shared/code_panel", title: "Source Code (React)", code: @source_code %>
    <%= render "shared/code_panel", title: "Converted Code (ERB)", code: @converted_code %>
  </section>
</main>
